# Localix Terminal: a bash started in a terminal tab reads this file. It reads the files a login bash
# reads (/etc/profile, then the person's first of .bash_profile, .bash_login, .profile), and
# has the shell say when a command starts and how it ended, so a wait on the terminal knows.
# None of the person's files is changed. The shell itself is not a login one: it ends with
# `exit`, not `logout`, and reads no .bash_logout.
if [ -r /etc/profile ]; then
  . /etc/profile
fi
for _llxterm_file in "$HOME/.bash_profile" "$HOME/.bash_login" "$HOME/.profile"; do
  if [ -r "$_llxterm_file" ]; then
    . "$_llxterm_file"
    break
  fi
done
unset _llxterm_file
# A shell with a DEBUG trap of its own is left as it is: there is one such trap.
if [[ $- == *i* && -z $(trap -p DEBUG) ]]; then
  # Set from the start, and read as `${name-}`: a profile may make an unset name an error.
  _llxterm_ran=
  _llxterm_armed=
  # First at each prompt: the command the person ran, if one, ended with this code.
  _llxterm_prompt() {
    local code=$?
    [[ -n ${_llxterm_ran-} ]] && builtin printf '\e]133;D;%s\a' "$code"
    _llxterm_ran=
    return "$code"
  }
  # Last at each prompt: the next command to run is the person's.
  _llxterm_arm() {
    _llxterm_armed=1
  }
  # Before each command. The first after a prompt is the person's, unless it is the next
  # prompt's own: Enter alone ran nothing. It is handed `$_`, which stays what it was. A line
  # that is one subshell alone, `( … )`, runs no command here, and is not said to start or end.
  _llxterm_debug() {
    [[ -z ${_llxterm_armed-} || -n ${COMP_LINE-} ]] && return
    _llxterm_armed=
    [[ $BASH_COMMAND == _llxterm_prompt ]] && return
    _llxterm_ran=1
    builtin printf '\e]133;C\a'
  }
  if [[ $(declare -p PROMPT_COMMAND 2>/dev/null) == "declare -a"* ]]; then
    PROMPT_COMMAND=(_llxterm_prompt "${PROMPT_COMMAND[@]}" _llxterm_arm)
  else
    # Each on a line of its own: the person's may end in `;` or a newline.
    PROMPT_COMMAND="_llxterm_prompt${PROMPT_COMMAND:+
$PROMPT_COMMAND}
_llxterm_arm"
  fi
  trap '_llxterm_debug "$_"' DEBUG
fi
