#!/bin/sh
# The plugin's `llxterm`, on the Bash tool's PATH: the program of Localix Terminal.app, which is all
# there is to install (opened once, it puts `llxterm` in ~/.local/bin, and Settings →
# Integrations installs this plugin). Found on the PATH, in ~/.local/bin, or in the app where
# macOS keeps apps; never downloaded.
set -eu

say() { printf 'llxterm: %s\n' "$*" >&2; }

# What says which Claude Code session called, not what the person set: a terminal the desk opens
# starts without it, so a `claude` run there is a session of its own, of its own directory.
export LLXTERM_SCRUB="CLAUDECODE,AI_AGENT,TRACEPARENT,CLAUDE_PID,CLAUDE_EFFORT,CLAUDE_PROJECT_DIR,\
CLAUDE_ENV_FILE,CLAUDE_PLUGIN_*,CLAUDE_CODE_TMPDIR,CLAUDE_CODE_INVOKED_SKILLS,CLAUDE_CODE_ENTRYPOINT,\
CLAUDE_CODE_EXECPATH,CLAUDE_CODE_SESSION_ID,CLAUDE_CODE_SESSION_ATTENDED,CLAUDE_CODE_CHILD_SESSION,\
CLAUDE_CODE_MESSAGING_SOCKET,CLAUDE_CODE_MESSAGING_TOKEN,CLAUDE_CODE_SUBAGENT_MODEL,LLXTERM_WRAPPED"

# An `llxterm` on the PATH that is not this script (nor another copy of it, which sets
# LLXTERM_WRAPPED before it looks).
if [ -z "${LLXTERM_WRAPPED:-}" ]; then
  export LLXTERM_WRAPPED=1
  here=$(cd "$(dirname "$0")" && pwd -P)
  old_ifs=$IFS
  IFS=:
  for dir in $PATH; do
    [ -n "$dir" ] && [ -x "$dir/llxterm" ] || continue
    [ "$(cd "$dir" 2>/dev/null && pwd -P)" = "$here" ] && continue
    IFS=$old_ifs
    # The first program found replaces this script; the loop goes on only past those it skips.
    # shellcheck disable=SC2093
    exec "$dir/llxterm" "$@"
  done
  IFS=$old_ifs
fi

for program in \
  "$HOME/.local/bin/llxterm" \
  "$HOME/Applications/Localix Terminal.app/Contents/MacOS/llxterm" \
  "/Applications/Localix Terminal.app/Contents/MacOS/llxterm"; do
  [ -x "$program" ] && exec "$program" "$@"
done

say "Localix Terminal is not installed: get it from https://github.com/localixai/localix-terminal/releases and open it once"
exit 127
