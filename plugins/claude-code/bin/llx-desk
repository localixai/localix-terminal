#!/bin/sh
# The plugin's `llx-desk`, on the Bash tool's PATH: the program of LLX Desk.app, which is all
# there is to install (opened once, it puts `llx-desk` in ~/.local/bin, and Settings →
# Integrations installs this plugin). Found on the PATH, in ~/.local/bin, or in the app where
# macOS keeps apps; never downloaded.
set -eu

say() { printf 'llx-desk: %s\n' "$*" >&2; }

# What says which Claude Code session called, not what the person set: a terminal the desk opens
# starts without it, so a `claude` run there is a session of its own, of its own directory.
export LLX_DESK_SCRUB="CLAUDECODE,AI_AGENT,TRACEPARENT,CLAUDE_PID,CLAUDE_EFFORT,CLAUDE_PROJECT_DIR,\
CLAUDE_ENV_FILE,CLAUDE_PLUGIN_*,CLAUDE_CODE_TMPDIR,CLAUDE_CODE_INVOKED_SKILLS,CLAUDE_CODE_ENTRYPOINT,\
CLAUDE_CODE_EXECPATH,CLAUDE_CODE_SESSION_ID,CLAUDE_CODE_SESSION_ATTENDED,CLAUDE_CODE_CHILD_SESSION,\
CLAUDE_CODE_MESSAGING_SOCKET,CLAUDE_CODE_MESSAGING_TOKEN,CLAUDE_CODE_SUBAGENT_MODEL,LLX_DESK_WRAPPED"

# An `llx-desk` on the PATH that is not this script (nor another copy of it, which sets
# LLX_DESK_WRAPPED before it looks).
if [ -z "${LLX_DESK_WRAPPED:-}" ]; then
  export LLX_DESK_WRAPPED=1
  here=$(cd "$(dirname "$0")" && pwd -P)
  old_ifs=$IFS
  IFS=:
  for dir in $PATH; do
    [ -n "$dir" ] && [ -x "$dir/llx-desk" ] || continue
    [ "$(cd "$dir" 2>/dev/null && pwd -P)" = "$here" ] && continue
    IFS=$old_ifs
    # The first program found replaces this script; the loop goes on only past those it skips.
    # shellcheck disable=SC2093
    exec "$dir/llx-desk" "$@"
  done
  IFS=$old_ifs
fi

for program in \
  "$HOME/.local/bin/llx-desk" \
  "$HOME/Applications/LLX Desk.app/Contents/MacOS/llx-desk" \
  "/Applications/LLX Desk.app/Contents/MacOS/llx-desk"; do
  [ -x "$program" ] && exec "$program" "$@"
done

say "LLX Desk is not installed: get it from https://github.com/rsaryev/llx-desk/releases and open it once"
exit 127
